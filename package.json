{
  "name": "qlint-contracts-reference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline reference contracts and cross-reference checks; not the full qlint CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/annenpolka/qlint.git"
  },
  "bin": {
    "qlint": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:types && node --test tests/*.test.mjs",
    "test:types": "node scripts/generate-contract-types.mjs && tsc -p tsconfig.typecheck.json",
    "qlint": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
