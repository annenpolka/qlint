{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qlint QuestionSuite v0.1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "minItems": 1
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "state",
    "questions",
    "bindings"
  ],
  "additionalProperties": false,
  "$defs": {
    "option": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "additionalProperties": false
    },
    "output": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "criteria": {
              "type": "object",
              "properties": {
                "true": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "false": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "true",
                "false"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "criteria"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "categorical"
            },
            "selection": {
              "enum": [
                "partition",
                "best_fit"
              ]
            },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/option"
              },
              "minItems": 2
            },
            "fallbackOptionId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "tieBreak": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "kind",
            "selection",
            "options"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ordinal"
            },
            "axis": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "levels": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/option"
              },
              "minItems": 2
            }
          },
          "required": [
            "kind",
            "axis",
            "levels"
          ],
          "additionalProperties": false
        }
      ]
    },
    "question": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "enum": [
            "extract",
            "interpret",
            "predict"
          ]
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "policyRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "applicability": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidenceBoundary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "missingInput": {
          "const": "abstain"
        },
        "insufficientEvidence": {
          "const": "abstain"
        },
        "prediction": {
          "type": "object",
          "properties": {
            "targetRef": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "horizon": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "targetRef",
            "horizon"
          ],
          "additionalProperties": false
        },
        "output": {
          "$ref": "#/$defs/output"
        }
      },
      "required": [
        "id",
        "revision",
        "mode",
        "instructions",
        "inputs",
        "policyRefs",
        "applicability",
        "evidenceBoundary",
        "missingInput",
        "insufficientEvidence",
        "output"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "predict"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "prediction"
            ]
          },
          "else": {
            "not": {
              "required": [
                "prediction"
              ]
            }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
        },
        "valueType": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "array",
            "object"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "availableFrom": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "role": {
          "enum": [
            "evidence",
            "policy",
            "target",
            "metadata"
          ]
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "restricted"
          ]
        }
      },
      "required": [
        "id",
        "pointer",
        "valueType",
        "nullable",
        "availableFrom",
        "role",
        "derivedFrom",
        "sensitivity"
      ],
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "after"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage"
          },
          "minItems": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "stages",
        "fields"
      ],
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "properties": {
        "purpose": {
          "enum": [
            "applicability",
            "evidence"
          ]
        },
        "questionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "falseAtMost": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "trueAtLeast": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "purpose",
        "questionId",
        "falseAtMost",
        "trueAtLeast"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "questionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "atStage": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "profile": {
          "enum": [
            "feature",
            "monitor",
            "router",
            "judge"
          ]
        },
        "gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gate"
          },
          "minItems": 0
        },
        "onIndeterminate": {
          "const": "abstain"
        }
      },
      "required": [
        "questionId",
        "atStage",
        "profile",
        "gates",
        "onIndeterminate"
      ],
      "additionalProperties": false
    }
  }
}
